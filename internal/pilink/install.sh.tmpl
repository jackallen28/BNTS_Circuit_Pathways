#!/usr/bin/env bash
# Circuit Pathways Pi Link: installer<%if .ID%> for the Pi labelled <%.ID%><%end%>
#
# Run this once on the Raspberry Pi:
#     sudo bash <%if .ID%>install-pi-<%.IDFile%>.sh<%else%>install.sh CPK1-XXXXXXXX-XXXXXXXXXX<%end%>
# It installs Pi Link, keeps this Pi's key, and starts Pi Link every time the Pi starts up. (A student Pi's own
# installer, from the school server, runs this for you: curl -fsSL http://pathways.local/install/student-pi.sh | sudo bash)
#
# Pi Link talks only to Circuit Pathways on this Pi itself (pin commands and pin states, and the
# program a student runs in PiPath and what it prints). Programs run as an unprivileged user with limits. To stop this Pi
# running students' programs:  sudo pilink run off     To remove everything:  sudo pilink uninstall
set -euo pipefail

SERVER="${CP_SERVER:-<%.Server%>}"
<%if .Key%>KEY="${CP_KEY:-<%.Key%>}"<%else%>KEY="${1:-${CP_KEY:-}}"<%end%>
NAME="${CP_NAME:-Raspberry Pi}"
RUN="${CP_RUN:-yes}"           # yes: the PiPath page may run students' programs on this Pi. no: pins only.
DESKTOP="${CP_DESKTOP:-yes}"   # yes: Circuit Pathways, PiPath and ArduinoPath shortcuts in the Pi menu and on the desktop
ROOT="${CP_PREFIX:-}"          # only for testing: install into this folder instead of the real system

say() { printf '\n==> %s\n' "$*"; }
die() { printf '\nSorry: %s\n' "$*" >&2; exit 1; }

case "$RUN" in yes|no) ;; *) die "CP_RUN must be yes or no" ;; esac
case "$DESKTOP" in yes|no) ;; *) die "CP_DESKTOP must be yes or no" ;; esac
KEY="$(printf '%s' "$KEY" | tr -d '[:space:]' | tr '[:lower:]' '[:upper:]')"
[[ "$KEY" =~ ^CPK1-([0-9A-Z]{8})-[0-9A-Z]{10}$ ]] || die "this Pi needs its key, like CPK1-K7M2QX9P-AB12CD34EF. Ask your teacher."
RAW_ID="${BASH_REMATCH[1]}"
ID="${RAW_ID:0:4}-${RAW_ID:4:4}"
[[ "$SERVER" =~ ^https?://[^[:space:]\"\'\\]+$ ]] || die "the website address '$SERVER' isn't right."

if [[ -z "$ROOT" && "$(id -u)" != 0 ]]; then
  [[ -f "$0" ]] || die "run this with:  sudo bash <this file>"
  exec sudo -E bash "$0" "$@"
fi

command -v python3 >/dev/null || die "Python 3 isn't installed. Is this a Raspberry Pi with Raspberry Pi OS?"

if [[ -z "$ROOT" ]]; then
  if ! python3 -c 'import gpiozero' 2>/dev/null; then
    say "Installing gpiozero (needs the internet)"
    apt-get update -qq && apt-get install -y -qq python3-gpiozero
  fi
  apt-get install -y -qq python3-lgpio >/dev/null 2>&1 || true   # the pin driver on newer Pis
  # Grove Base Hat: Seeed's grove.py library (analog sensors, the Ultrasonic Ranger...) and I2C switched on.
  # Best effort: a Pi without a Base Hat works without them. CP_GROVE=no skips this.
  if [[ "${CP_GROVE:-yes}" != no ]]; then
    say "Setting up the Grove Base Hat library (grove.py)"
    command -v raspi-config >/dev/null && raspi-config nonint do_i2c 0 >/dev/null 2>&1 || true
    python3 -c 'import grove' 2>/dev/null || pip3 install -q --break-system-packages grove.py >/dev/null 2>&1 || pip3 install -q grove.py >/dev/null 2>&1 || \
      printf '\nNote: grove.py could not be installed (no internet?). Grove lessons with analog sensors need it: run  sudo pip3 install --break-system-packages grove.py\n'
  fi
fi

say "Installing Pi Link for the Pi $ID"
install -d "$ROOT/opt/circuitpathways-pi" "$ROOT/etc" "$ROOT/usr/local/bin"
cat > "$ROOT/opt/circuitpathways-pi/circuitpathways_pi.py" <<'PYTHON_APP_END'
<%.App%>
PYTHON_APP_END
chmod 644 "$ROOT/opt/circuitpathways-pi/circuitpathways_pi.py"

umask 077
cat > "$ROOT/etc/circuitpathways-pi.conf" <<EOF
# This Pi's key and the website it links to. Keep the key private.
KEY=$KEY
SERVER=$SERVER
NAME=$NAME
# RUN=yes lets the PiPath page run a student's program on this Pi (as RUN_USER, with limits).
RUN=$RUN
RUN_USER=cprun
RUN_DIR=/var/lib/circuitpathways-pi/run
EOF
umask 022
printf '%s\n' "$ID" > "$ROOT/etc/circuitpathways-pi.id"
printf '%s\n' "${SERVER%/}" > "$ROOT/etc/circuitpathways-pi.site"   # the website (no key), for the shortcuts
for d in "$ROOT/boot/firmware" "$ROOT/boot"; do
  if [[ -d "$d" ]]; then printf 'Pi Link ID: %s\nType this ID on the PiPath page to link to this Pi.\n' "$ID" > "$d/PI-LINK-ID.txt"; break; fi
done

cat > "$ROOT/usr/local/bin/pilink" <<'PILINK_END'
#!/usr/bin/env bash
# pilink: look after Pi Link on this Pi.   pilink id | show | status | log | restart | run on|off | server URL | uninstall
CONF=/etc/circuitpathways-pi.conf
case "${1:-status}" in
  id) cat /etc/circuitpathways-pi.id ;;
  show)
    printf '\n\n      Circuit Pathways Pi Link\n\n      This Pi'"'"'s ID:   %s\n\n      Type it on the PiPath page to link to this Pi.\n\n' "$(cat /etc/circuitpathways-pi.id)"
    systemctl is-active --quiet circuitpathways-pi && echo "      Status: running" || echo "      Status: NOT running (try: sudo pilink restart)"
    echo; read -r -t 120 -p "      Press Enter to close." _ || true ;;
  status) printf 'ID: %s\n' "$(cat /etc/circuitpathways-pi.id)"; grep -E '^(SERVER|RUN)=' "$CONF"; systemctl --no-pager status circuitpathways-pi | head -12 ;;
  run)
    case "${2:-}" in
      on|off)
        V=yes; [ "$2" = off ] && V=no
        sed -i "s|^RUN=.*|RUN=$V|" "$CONF" && systemctl restart circuitpathways-pi
        echo "Students' programs on this Pi: $2 (pins can still be controlled)" ;;
      *) grep '^RUN=' "$CONF"; echo "usage: sudo pilink run on|off" ;;
    esac ;;
  log) journalctl -u circuitpathways-pi -n "${2:-40}" --no-pager ;;
  restart) systemctl restart circuitpathways-pi && echo restarted ;;
  server)
    [[ "${2:-}" =~ ^https?:// ]] || { echo "usage: sudo pilink server https://your-site.example"; exit 1; }
    sed -i "s|^SERVER=.*|SERVER=$2|" "$CONF" && printf '%s\n' "${2%/}" > /etc/circuitpathways-pi.site && systemctl restart circuitpathways-pi && echo "Now linking through $2" ;;
  uninstall)
    systemctl disable --now circuitpathways-pi 2>/dev/null || true
    rm -f /etc/systemd/system/circuitpathways-pi.service /etc/xdg/autostart/circuitpathways-pi-id.desktop \
          /etc/circuitpathways-pi.conf /etc/circuitpathways-pi.id /etc/circuitpathways-pi.site /boot/firmware/PI-LINK-ID.txt /boot/PI-LINK-ID.txt \
          /usr/local/bin/pilink /usr/local/bin/circuitpathways /usr/share/applications/circuitpathways*.desktop \
          /usr/share/icons/hicolor/scalable/apps/circuitpathways.svg /home/*/Desktop/circuitpathways.desktop
    rm -rf /opt/circuitpathways-pi /var/lib/circuitpathways-pi; systemctl daemon-reload; userdel cplink 2>/dev/null || true; userdel cprun 2>/dev/null || true
    echo "Pi Link has been removed." ;;
  *) echo "usage: pilink id | show | status | log | restart | run on|off | server URL | uninstall" ;;
esac
PILINK_END
chmod 755 "$ROOT/usr/local/bin/pilink"

# The Raspberry Pi version: students use this Pi as their computer. The shortcuts open the
# website in Chromium as an app window, with this Pi's ID, so PiPath runs programs on this Pi
# with no ID to type. Work is saved in Chromium on this Pi (and with the student's class).
cat > "$ROOT/usr/local/bin/circuitpathways" <<'LAUNCH_END'
#!/usr/bin/env bash
# circuitpathways [home|pipath|arduinopath]: opens Circuit Pathways on this Pi, linked to this Pi.
ETC="${CP_ETC:-/etc}"   # only for testing
SITE="$(cat "$ETC/circuitpathways-pi.site" 2>/dev/null)"
ID="$(cat "$ETC/circuitpathways-pi.id" 2>/dev/null)"
[[ "$SITE" =~ ^https?:// ]] || { echo "Circuit Pathways isn't set up on this Pi (run its installer)." >&2; exit 1; }
case "${1:-home}" in
  pipath) PAGE=/pipath/ ;;
  arduinopath) PAGE=/arduinopath/ ;;
  *) PAGE=/ ;;
esac
URL="$SITE$PAGE?pi=$ID"
# Flags that suit a Pi in a classroom: no first-run page, no password-keyring prompt, no translate bar,
# and a big disk cache so the site's large files (Python) are only downloaded once.
FLAGS=(--no-first-run --no-default-browser-check --password-store=basic --disable-features=Translate --disk-cache-size=268435456)
# A Pi with about 2 GB of memory or less (Zero 2, 3, 2 GB 4): Chromium's low-memory mode.
MEM_KB="$(awk '/^MemTotal:/ { print $2 }' "${CP_MEMINFO:-/proc/meminfo}" 2>/dev/null)"
if [[ "${MEM_KB:-0}" =~ ^[0-9]+$ && "${MEM_KB:-0}" -gt 0 && "${MEM_KB:-0}" -le 2300000 ]]; then FLAGS+=(--enable-low-end-device-mode); fi
# CP_CHROMIUM_FLAGS adds more (for IT to try things out)
# shellcheck disable=SC2206
[[ -n "${CP_CHROMIUM_FLAGS:-}" ]] && FLAGS+=($CP_CHROMIUM_FLAGS)
for b in chromium-browser chromium google-chrome; do
  command -v "$b" >/dev/null && exec "$b" "${FLAGS[@]}" --app="$URL"
done
exec xdg-open "$URL"
LAUNCH_END
chmod 755 "$ROOT/usr/local/bin/circuitpathways"

if [[ "$DESKTOP" = yes ]] && [[ -n "$ROOT" || -d /usr/share/applications ]]; then
  install -d "$ROOT/usr/share/applications" "$ROOT/usr/share/icons/hicolor/scalable/apps"
  cat > "$ROOT/usr/share/icons/hicolor/scalable/apps/circuitpathways.svg" <<'ICON_END'
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="12" fill="#704988"/><rect x="8" y="8" width="10" height="10" fill="#19C1CA"/><rect x="20" y="8" width="10" height="10" fill="#CFC2E0"/><rect x="8" y="20" width="10" height="10" fill="#04BBC1"/><path d="M20 46h10l6-12 6 20 5-8h9" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="20" cy="46" r="4" fill="#19C1CA"/></svg>
ICON_END
  shortcut() { # file name, page, words
    cat > "$ROOT/usr/share/applications/$1.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$3
Comment=Learn to code with Circuit Pathways (linked to this Pi, $ID)
Exec=/usr/local/bin/circuitpathways $2
Icon=circuitpathways
Terminal=false
Categories=Education;Development;
EOF
  }
  shortcut circuitpathways home "Circuit Pathways"
  shortcut circuitpathways-pipath pipath "PiPath (Python on this Pi)"
  shortcut circuitpathways-arduinopath arduinopath "ArduinoPath (Arduino and ESP)"
  if [[ -z "$ROOT" ]]; then
    # ...and one on each desktop already on this Pi
    for d in /home/*/Desktop; do
      [[ -d "$d" ]] || continue
      u="$(stat -c %U "$d")"
      install -m 755 -o "$u" -g "$(id -gn "$u" 2>/dev/null || echo "$u")" /usr/share/applications/circuitpathways.desktop "$d/circuitpathways.desktop" 2>/dev/null || true
    done
    command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
  fi
fi

if [[ -z "$ROOT" ]]; then
  say "Setting up the service that starts at every boot"
  if [[ "$RUN" = yes ]]; then
    # Students' programs run as "cprun": a user with no password, no login and no home, who can only
    # use the pins, camera and sensors. The Pi Link service itself has to be root to hand programs
    # to that user, so it is locked down: it can't see home folders and can only write to its own folder.
    id cprun >/dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin cprun
    for g in gpio video i2c spi render; do getent group "$g" >/dev/null && usermod -a -G "$g" cprun; done
    install -d -m 755 /var/lib/circuitpathways-pi /var/lib/circuitpathways-pi/run
    chown root:root /etc/circuitpathways-pi.conf; chmod 600 /etc/circuitpathways-pi.conf
    cat > /etc/systemd/system/circuitpathways-pi.service <<EOF
[Unit]
Description=Circuit Pathways Pi Link ($ID)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 -u /opt/circuitpathways-pi/circuitpathways_pi.py --config /etc/circuitpathways-pi.conf
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=circuitpathways-pi
PrivateTmp=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_KILL CAP_DAC_OVERRIDE CAP_FOWNER
TasksMax=256
MemoryMax=75%

[Install]
WantedBy=multi-user.target
EOF
  else
    if ! id cplink >/dev/null 2>&1; then
      useradd --system --no-create-home --shell /usr/sbin/nologin cplink
    fi
    GROUP=cplink
    if getent group gpio >/dev/null; then usermod -a -G gpio cplink; GROUP=gpio; fi
    chown cplink:"$GROUP" /etc/circuitpathways-pi.conf; chmod 600 /etc/circuitpathways-pi.conf
    cat > /etc/systemd/system/circuitpathways-pi.service <<EOF
[Unit]
Description=Circuit Pathways Pi Link ($ID)
After=network-online.target
Wants=network-online.target

[Service]
User=cplink
Group=$GROUP
ExecStart=/usr/bin/python3 -u /opt/circuitpathways-pi/circuitpathways_pi.py --config /etc/circuitpathways-pi.conf
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF
  fi
  # On a Pi with a desktop, show the ID in a small window each time it starts.
  if [[ -d /etc/xdg/autostart ]] && command -v lxterminal >/dev/null; then
    cat > /etc/xdg/autostart/circuitpathways-pi-id.desktop <<EOF
[Desktop Entry]
Type=Application
Name=Pi Link ID
Exec=lxterminal --title="Pi Link" --geometry=60x14 -e pilink show
EOF
  fi
  systemctl daemon-reload
  systemctl enable --now circuitpathways-pi
  sleep 2
  if systemctl is-active --quiet circuitpathways-pi; then STATE="running"; else STATE="NOT running: see  sudo pilink log"; fi
  if command -v curl >/dev/null && ! curl -fsS -m 8 "$SERVER/healthz" >/dev/null 2>&1; then
    printf '\nNote: this Pi could not reach %s just now. Check its WiFi or network cable.\n' "$SERVER"
  fi
else
  STATE="installed into $ROOT (test mode)"
fi

cat <<EOF

=====================================================
  Pi Link is installed and $STATE

  This Pi's ID:   $ID

  Students open Circuit Pathways, PiPath or ArduinoPath
  from the Pi menu or the desktop. In PiPath, programs
  run on this Pi's pins by themselves.
  It starts each time the Pi turns on.
  Handy commands:  pilink show | status | log
  Students' programs on this Pi: $RUN  (pilink run on|off)
=====================================================
EOF
